{
  "buildCommand": "node generate-data.js",
  "outputDirectory": ".",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "destination": "/main.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
